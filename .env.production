NODE_ENV=production
# delete or not console.log  TRUE or FALSE
BUILD_ON_CLEAN_CONSOLE=TRUE

# vue public path
VUE_APP_PUBLIC_PATH=./

# Whether to open the mock TRUE or FALSE
VUE_APP_USE_MOCK=FALSE

# interface address
GLOB_API_URL=/api

GLOB_KEYBOARD_URL=/keyboard

# Interface prefix
GLOB_API_URL_PREFIX=/