NODE_ENV=development

# Whether to open mock
VUE_APP_USE_MOCK =FALSE

# public path
VUE_APP_PUBLIC_PATH =./

# Cross-domain proxy, you can configure multiple
VUE_APP_PROXY=[["/api","http://192.168.85.129:8011/Server.asmx"],["/keyboard","http://localhost:1606"],["/machine","http://localhost:9666"],["/upload","http://192.168.85.129:8011/Server.asmx"]]

# Delete console
BUILD_ON_CLEAN_CONSOLE =FALSE

# Basic interface address SPA
GLOB_API_URL=/api

GLOB_KEYBOARD_URL=/keyboard

# Interface prefix
GLOB_API_URL_PREFIX=