{
    "presets": [
        "@babel/preset-flow",
        [
            "@babel/preset-env",
            {
                "targets": {
                    "node": "8.10"
                },
                "corejs": "3", // 声明corejs版本
                "useBuiltIns": "usage"
            }
        ]
    ],
    "plugins": [
        [
            "component",
            {
                "libraryName": "element-plus",
                "styleLibraryName": "theme-chalk"
            }
        ]
    ],
}